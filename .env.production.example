# LEOC Production Deployment Configuration
# Copy this to .env and customize for your environment

# ==================================================
# CRITICAL: Application Configuration
# ==================================================

# Flask application settings
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False

# ==================================================
# CRITICAL SECURITY: Secret Key
# ==================================================
# IMPORTANT: Generate a strong random key with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
#
# DO NOT use the placeholder below!
# DO NOT commit real keys to version control!
SECRET_KEY=GENERATE_AND_REPLACE_WITH_YOUR_STRONG_KEY

# ==================================================
# Database Configuration (PostgreSQL - Production)
# ==================================================
# Format: postgresql://user:password@host:port/database
# In Docker Compose, host is the service name 'leoc-db'
SQLALCHEMY_DATABASE_URI=postgresql://leoc:leoc_prod_pass@leoc-db:5432/leoc
DB_PASSWORD=leoc_prod_pass

# ==================================================
# File Upload Settings
# ==================================================
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# ==================================================
# Server Configuration
# ==================================================
PORT=5002

# ==================================================
# Security: Unlock Key (legacy, kept for reference)
# ==================================================
UNLOCK_KEY=admin123

# ==================================================
# Cache Configuration
# ==================================================
CACHE_TIMEOUT=300

# ==================================================
# Logging Configuration
# ==================================================
LOG_LEVEL=INFO

# ==================================================
# Optional: Performance Tuning
# ==================================================
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
